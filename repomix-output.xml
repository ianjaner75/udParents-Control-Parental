                repositorio.bloquearApp(uidHijo, paquete, bloquear)
                // Actualiza el estado localmente para reflejar el cambio
                _estadoBloqueoApp.value = _estadoBloqueoApp.value.toMutableMap().apply {
                    put(paquete, bloquear)
