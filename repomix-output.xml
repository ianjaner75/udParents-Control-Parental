                }

                Spacer(Modifier.height(16.dp))

                // Lista de usos de aplicaciones (Ficha Técnica se mejoro xd)
                if (mostrarFicha) {
                    LazyColumn(
                        verticalArrangement = Arrangement.spacedBy(8.dp),
                        modifier = Modifier.fillMaxHeight()
                    ) {
                        items(usos) { app ->
